# Env exclusivo da suíte de testes (vitest). Copie para apps/api/.env.test — ou
# rode `npm run db:test:setup`, que faz essa cópia sozinho se o arquivo não
# existir. NUNCA aponte estas variáveis para o banco de desenvolvimento nem
# para produção: `apps/api/vitest.setup.ts` trava a suíte se o database em
# DATABASE_URL ou DIRECT_DATABASE_URL não terminar em "_test".
NODE_ENV=test
PORT=3001

# ── Banco de dados de teste ──────────────────────────────────────────────────
# Mesmo cluster Postgres do ambiente de desenvolvimento (porta 5433 pelo
# scripts/dev-db.ps1, ou 5432 pelo docker-compose.yml) — só o database muda.
# `npm run db:test:setup` cria "gestao_comercial_test" se não existir e aplica
# o schema (prisma migrate deploy). O nome PRECISA terminar em "_test" nos dois
# endereços abaixo, senão a suíte se recusa a rodar.
DATABASE_URL="postgresql://app_user:app_user_pw@localhost:5433/gestao_comercial_test?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/gestao_comercial_test?schema=public"

# Senha do role app_user. O role é do CLUSTER (compartilhado por todos os
# databases, incluindo o de desenvolvimento). `npm run db:test:setup` só usa
# este valor para criar a senha do role QUANDO ELE AINDA NÃO EXISTE no
# cluster (primeiro setup); se o role já existir, o script pula esse passo e
# não toca na senha dele — não reescreve a senha de desenvolvimento. Ainda
# assim, deixe este valor IGUAL ao APP_USER_PASSWORD do seu apps/api/.env de
# desenvolvimento: se forem diferentes, o login do banco de teste falha por
# senha (a mensagem do `db:test:setup` te lembra disso quando pula o passo).
APP_USER_PASSWORD="app_user_pw"

# ── Criptografia e Better Auth — valores de teste, nunca os de dev/produção ──
ENCRYPTION_KEY="G4hasT3ptfvTUjOT2BYRfto36xpdmm6BUBBuIu34jdU="
BETTER_AUTH_SECRET="teste-vitest-nao-usar-em-dev-ou-producao-32"
BETTER_AUTH_URL="http://localhost:3001"
WEB_ORIGIN="http://localhost:3000"

# Seed do casal — não usado pela suíte hoje, mas mantido pelo mesmo schema de
# env do .env.example para consistência.
SEED_OWNER1_EMAIL="owner1@example.com"
SEED_OWNER2_EMAIL="owner2@example.com"
SEED_OWNER_PASSWORD="senha-de-teste-local"

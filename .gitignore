# Dependências
node_modules/

# Builds
dist/
.next/
out/
build/

# Cache do Turborepo
.turbo/

# Cluster Postgres local efêmero (fallback sem Docker — ver README)
.devdb/

# Variáveis de ambiente — segredos NUNCA entram no repo
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo

# Claude Code — memória de subagente e settings locais não são versionados
# (ver CLAUDE.md § "Versionamento do .claude/")
.claude/agent-memory/
.claude/settings.local.json
.claude/*.graphify-bak

# graphify: versiona só o grafo consultável; HTML e relatório são regenerados localmente
graphify-out/*
!graphify-out/graph.json

# Sistema operacional / editor
.DS_Store
Thumbs.db
